   "link": null,
   "locked": false,
   "text": "RESET FOR A FRESH DEMO\n1) stop the backend (Ctrl+C)\n2) rm -rf backend/storage\n3) start the backend again\nKeep backend/cache/ (GPT answers) and\n~/.cache/huggingface (models).\nNever delete storage/ while the server runs →\n\"readonly database\" error",
   "originalText": "RESET FOR A FRESH DEMO\n1) stop the backend (Ctrl+C)\n2) rm -rf backend/storage\n3) start the backend again\nKeep backend/cache/ (GPT answers) and\n~/.cache/huggingface (models).\nNever delete storage/ while the server runs →\n\"readonly database\" error",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "reset",
   "lineHeight": 1.25,
   "autoResize": true

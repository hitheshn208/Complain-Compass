   "updated": 1763000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "n-score-t",
   "type": "text",
   "x": 3124,
   "y": 590.0,
   "width": 525.2800000000001,
   "height": 262.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1139027120,
   "version": 1,
   "versionNonce": 568896617,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1763000000000,
   "link": null,
   "locked": false,
   "text": "PRIORITY FORMULA (each part 0–100; defaults below, editable on the\nPriority settings page; must sum to 100%)\nIMPACT 35%: 100·ln(1+u)/ln(1+u_max), u = unique affected customers\nSEVERITY 25%: 0.6·mean + 0.4·p90 of complaint points (CRITICAL 100,\nHIGH 75, MEDIUM 45, LOW 15)\nRECURRENCE 20%: ½ share of customers hit ≥ 2 times + ½ share of\nweeks active\nGROWTH 10%: sigmoid of last 7 days vs prior weekly avg; 50 = flat;\n50 if < 14 days of data\nBUSINESS 10%: 0.7·category weight (Payments 90 … Other 30) +\n0.3·share mentioning money/orders\nIssue severity label: score ≥ 87.5 CRITICAL, ≥ 60 HIGH, ≥ 30\nMEDIUM, else LOW\ne.g. 7 MEDIUM + 3 CRITICAL → 76.9 HIGH; 9 MEDIUM + 1 CRITICAL →\n50.5 MEDIUM",
   "originalText": "PRIORITY FORMULA (each part 0–100; defaults below, editable on the\nPriority settings page; must sum to 100%)\nIMPACT 35%: 100·ln(1+u)/ln(1+u_max), u = unique affected customers\nSEVERITY 25%: 0.6·mean + 0.4·p90 of complaint points (CRITICAL 100,\nHIGH 75, MEDIUM 45, LOW 15)\nRECURRENCE 20%: ½ share of customers hit ≥ 2 times + ½ share of\nweeks active\nGROWTH 10%: sigmoid of last 7 days vs prior weekly avg; 50 = flat;\n50 if < 14 days of data\nBUSINESS 10%: 0.7·category weight (Payments 90 … Other 30) +\n0.3·share mentioning money/orders\nIssue severity label: score ≥ 87.5 CRITICAL, ≥ 60 HIGH, ≥ 30\nMEDIUM, else LOW\ne.g. 7 MEDIUM + 3 CRITICAL → 76.9 HIGH; 9 MEDIUM + 1 CRITICAL →\n50.5 MEDIUM",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "n-score",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "n-why",
   "type": "rectangle",
   "x": 3110,
   "y": 912.5,
   "width": 560,
   "height": 232.5,
   "angle": 0,

   "locked": false
  },
  {
   "id": "n-vik-t",
   "type": "text",
   "x": 3124,
   "y": 335.0,
   "width": 509.6,
   "height": 175.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1968321320,
   "version": 1,
   "versionNonce": 429416214,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1763000000000,
   "link": null,
   "locked": false,
   "text": "WORKED EXAMPLE: Vik (CUST-1060), order ORD-396765\n16 Oct  CSV, email row → opens the incident\n16 Oct  CSV, social row → same order (T1, 95%)\n17 Oct  email followup_07 → sender email via directory\n17 Oct  email followup_08 (reworded) → same order\n18 Oct  tweet SM-X01 → handle @vik_1060 only, via directory\n19 Oct  chat CHAT-X01 → phone only; typed \"order number 396765\" →\nORD-396765\n= 6 reports, 4 channels → 1 incident, 1 affected customer\nDemo: Complaints → search 396765 → click the chat",
   "originalText": "WORKED EXAMPLE: Vik (CUST-1060), order ORD-396765\n16 Oct  CSV, email row → opens the incident\n16 Oct  CSV, social row → same order (T1, 95%)\n17 Oct  email followup_07 → sender email via directory\n17 Oct  email followup_08 (reworded) → same order\n18 Oct  tweet SM-X01 → handle @vik_1060 only, via directory\n19 Oct  chat CHAT-X01 → phone only; typed \"order number 396765\" →\nORD-396765\n= 6 reports, 4 channels → 1 incident, 1 affected customer\nDemo: Complaints → search 396765 → click the chat",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "n-vik",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "n-score",
   "type": "rectangle",
   "x": 3110,
   "y": 570.0,
   "width": 560,
   "height": 302.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#f8f9fa",

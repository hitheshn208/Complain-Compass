  },
  {
   "id": "n-concepts-t",
   "type": "text",
   "x": 3124,
   "y": 80.0,
   "width": 493.9200000000001,
   "height": 175.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1963764598,
   "version": 1,
   "versionNonce": 1357970699,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1763000000000,
   "link": null,
   "locked": false,
   "text": "THE 3 CONCEPTS (answer to \"how do you avoid double counting?\")\nCOMPLAINT = one message as received\nINCIDENT = one customer's one problem, however many times /\nchannels → built by STAGE 6 (dedup)\nISSUE = one problem shared by many customers → built by STAGE 4\n(clustering)\nDifferent customers, same problem → same ISSUE, more affected\ncustomers\nSame customer, same problem again → same INCIDENT, counted once\nRankings use unique customers, never raw report counts",
   "originalText": "THE 3 CONCEPTS (answer to \"how do you avoid double counting?\")\nCOMPLAINT = one message as received\nINCIDENT = one customer's one problem, however many times /\nchannels → built by STAGE 6 (dedup)\nISSUE = one problem shared by many customers → built by STAGE 4\n(clustering)\nDifferent customers, same problem → same ISSUE, more affected\ncustomers\nSame customer, same problem again → same INCIDENT, counted once\nRankings use unique customers, never raw report counts",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "n-concepts",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "n-vik",
   "type": "rectangle",
   "x": 3110,
   "y": 315.0,
   "width": 560,

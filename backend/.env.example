# Copy to backend/.env and adjust. All values are optional except where noted.

# --- LLM (optional). Without a key the app uses deterministic fallback classification/labels.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=30

# --- Storage (relative to where uvicorn is started, or absolute)
DB_PATH=storage/complaint_compass.db
CHROMA_DIR=storage/chroma
CHROMA_COLLECTION=complaints

# --- Embeddings
EMBEDDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64

# --- Upload
MAX_UPLOAD_MB=20

# --- Clustering
HDBSCAN_MIN_CLUSTER_SIZE=8
HDBSCAN_MIN_SAMPLES=4
CLUSTER_MERGE_THRESHOLD=0.5
CLUSTER_MATCH_THRESHOLD=0.8
REPRESENTATIVES_PER_CLUSTER=5

# --- Deduplication
DEDUP_TIME_WINDOW_DAYS=7
DEDUP_SEMANTIC_THRESHOLD=0.55
DEDUP_AUTO_MERGE_CONFIDENCE=0.75
DEDUP_REVIEW_CONFIDENCE=0.45

# --- Priority weights (must sum to 1.0)
WEIGHT_IMPACT=0.35
WEIGHT_SEVERITY=0.25
WEIGHT_RECURRENCE=0.20
WEIGHT_GROWTH=0.10
WEIGHT_BUSINESS=0.10

# --- Trends
TREND_BASELINE_DAYS=14
TREND_RECENT_DAYS=3
TREND_Z_THRESHOLD=2.0
TREND_MIN_RECENT_COUNT=3

# --- Segmentation privacy threshold
SEGMENT_MIN_CUSTOMERS=3

# --- Multi-channel ingestion
MAX_BATCH_UPLOAD_MB=200
MAX_FILES_PER_UPLOAD=500
# Voice transcription: local (faster-whisper, offline) | openai (needs OPENAI_API_KEY) | none
TRANSCRIBER=local
WHISPER_MODEL=base
WHISPER_DEVICE=cpu # cuda | cpu
WHISPER_COMPUTE_TYPE=int8
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Salt for hashing contact details in the customer directory. Set your own secret value;
# changing it later invalidates the stored directory.
IDENTITY_SALT=change-me
